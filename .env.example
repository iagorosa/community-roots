# Consumido pelo docker-compose.yml.
# Copie para .env e ajuste: cp .env.example .env

POSTGRES_USER=community_roots
POSTGRES_PASSWORD=troque-isto-localmente
POSTGRES_DB=community_roots

# Porta do host para o container do banco.
# 5433 e 54322 já estão ocupadas por outros Postgres nesta máquina.
POSTGRES_PORT=5432
