# Copie para backend/.env e ajuste: cp backend/.env.example backend/.env

# --- Aplicação -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Banco de dados ------------------------------------------------------
# Precisa bater com as credenciais e a porta definidas no .env da raiz.
DATABASE_URL=postgresql+psycopg://community_roots:troque-isto-localmente@localhost:5432/community_roots
TEST_DATABASE_URL=postgresql+psycopg://community_roots:troque-isto-localmente@localhost:5432/community_roots_test

# --- URLs públicas -------------------------------------------------------
# Onde a aplicação React está acessível. Os QR Codes codificam
# {PUBLIC_WEB_BASE_URL}/r/{qr_token}, então mudar isto depois de imprimir
# os códigos invalida todos eles.
PUBLIC_WEB_BASE_URL=http://localhost:5173

# Separadas por vírgula. Nunca use "*" fora do ambiente local.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Acesso administrativo -----------------------------------------------
# Exigido por POST/PATCH /api/regions, enviado no header X-Admin-Token.
# A aplicação se recusa a subir com este valor quando ENVIRONMENT=production.
ADMIN_API_TOKEN=troque-isto-localmente

# --- Armazenamento de fotos ----------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=10485760
ALLOWED_IMAGE_FORMATS=JPEG,PNG,WEBP

# --- Dados de desenvolvimento --------------------------------------------
# Centro da área de plantio, em Matias Barbosa/MG.
# Os canteiros do seed são placeholders fictícios gerados ao redor deste ponto.
SEED_CENTER_LAT=-21.883859
SEED_CENTER_LON=-43.312459
SEED_REGION_COUNT=10
