# Copy to backend/.env and adjust: cp backend/.env.example backend/.env

# --- Application ---------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ------------------------------------------------------------
# Must match the credentials and port set in the root .env file.
DATABASE_URL=postgresql+psycopg://community_roots:change-me-locally@localhost:5432/community_roots
TEST_DATABASE_URL=postgresql+psycopg://community_roots:change-me-locally@localhost:5432/community_roots_test

# --- Public URLs ---------------------------------------------------------
# Where the React app is reachable. QR codes encode {PUBLIC_WEB_BASE_URL}/r/{qr_token},
# so changing this after codes are printed invalidates them.
PUBLIC_WEB_BASE_URL=http://localhost:5173

# Comma-separated. Never use "*" outside local development.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Admin access --------------------------------------------------------
# Required by POST/PATCH /api/regions, sent as the X-Admin-Token header.
# The application refuses to start with this value when ENVIRONMENT=production.
ADMIN_API_TOKEN=change-me-locally

# --- Photo storage -------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=10485760
ALLOWED_IMAGE_FORMATS=JPEG,PNG,WEBP

# --- Development seed ----------------------------------------------------
# Centre of the planting area in Matias Barbosa/MG.
# Seed regions are fictional placeholders generated around this point.
SEED_CENTER_LAT=-21.883859
SEED_CENTER_LON=-43.312459
SEED_REGION_COUNT=10
