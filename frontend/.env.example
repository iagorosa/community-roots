# Copie para frontend/.env e ajuste: cp frontend/.env.example frontend/.env
# Só variáveis com prefixo VITE_ chegam ao navegador. Nunca coloque segredo aqui.

# Vazio em desenvolvimento, para as requisições irem pelo proxy do Vite em /api.
# Em build de produção, aponte para a origem completa do backend.
VITE_API_BASE_URL=

# Tiles do mapa. O OpenStreetMap não exige API key; a atribuição é obrigatória.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Enquadramento inicial, antes de conhecer os limites dos canteiros
# (Matias Barbosa/MG).
VITE_MAP_DEFAULT_LAT=-21.883859
VITE_MAP_DEFAULT_LON=-43.312459
VITE_MAP_DEFAULT_ZOOM=17
