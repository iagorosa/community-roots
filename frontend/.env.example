# Copy to frontend/.env and adjust: cp frontend/.env.example frontend/.env
# Only VITE_-prefixed variables reach the browser bundle. Never put a secret here.

# Left empty in development so requests go through the Vite proxy at /api.
# Set to the full backend origin in production builds.
VITE_API_BASE_URL=

# Map tiles. OpenStreetMap requires no API key; attribution is mandatory.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Initial map view before region bounds are known (Matias Barbosa/MG).
VITE_MAP_DEFAULT_LAT=-21.883859
VITE_MAP_DEFAULT_LON=-43.312459
VITE_MAP_DEFAULT_ZOOM=17
